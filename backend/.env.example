# Backend Environment Variables - Production
# Copiar este archivo a .env y configurar valores reales

# Environment
ENVIRONMENT=production

# Database (cuando migres de in-memory)
# DATABASE_URL=postgresql://user:password@localhost:5432/labordoc_prod

# Security
# SECRET_KEY=tu-clave-secreta-muy-segura-aqui
# ALLOWED_ORIGINS=https://labordoc.com,https://www.labordoc.com

# API Configuration
# MAX_WORKERS=4
# LOG_LEVEL=info
